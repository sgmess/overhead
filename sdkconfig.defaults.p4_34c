# Waveshare ESP32-P4-WIFI6-Touch-LCD-3.4C: ESP32-P4 rev v3.1+, 800x800 MIPI DSI
CONFIG_IDF_TARGET="esp32p4"
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_301=y
CONFIG_BSP_LCD_TYPE_800_800_3_4_INCH=y
# The rev v3 bootloader overflows its slot before the partition table at Info level
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Performance, as in the Waveshare LVGL example
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_LV_DEF_REFR_PERIOD=15

# TLS buffers in PSRAM. With esp_hosted 1.4 the P4 had room for them
# internally, but 2.x leaves too little: on the Tab5 about 50 KB, largest
# block 14 KB, under a full TLS record (see sdkconfig.defaults.tab5).
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# WiFi via the ESP32-C6 co-processor, running esp_hosted 2.x. Its default
# pins (SDIO slot 1: CLK 18, CMD 19, D0-D3 14-17; reset GPIO 54) are this
# board's.
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=12
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=12

# Code and rodata run from PSRAM, so IDF keeps the cache on through flash
# reads, writes and erases (SPI_FLASH_CACHE_NO_DISABLE), as on the Tab5.
# Without it the panel, which streams from PSRAM, flashed through updates
# and settings saves, and a task with its stack in PSRAM can't touch flash:
# the OpenAIP map cache boot-looped here (October 2026).
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
