# Waveshare ESP32-P4-WIFI6-Touch-LCD-3.4C: ESP32-P4 rev v3.1+, 800x800 MIPI DSI
CONFIG_IDF_TARGET="esp32p4"
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_301=y
CONFIG_BSP_LCD_TYPE_800_800_3_4_INCH=y
# The rev v3 bootloader overflows its slot before the partition table at Info level
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Performance, as in the Waveshare LVGL example
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_LV_DEF_REFR_PERIOD=15

# The P4 has room for mbedTLS in internal RAM
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

# WiFi via the ESP32-C6 co-processor
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=12
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=12
