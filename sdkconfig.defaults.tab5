# M5Stack Tab5: ESP32-P4 rev v1.x, 5" 720x1280 MIPI DSI (portrait native),
# WiFi via an ESP32-C6 over SDIO.
CONFIG_IDF_TARGET="esp32p4"

# The Tab5's P4 is rev v1.3. IDF builds pre-v3 and v3+ P4 images differently,
# so this board can't share the 3.4C's settings.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# As M5Stack's Tab5 demo firmware
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_LV_DEF_REFR_PERIOD=15

# TLS buffers in PSRAM. esp_hosted 2.x left ~50 KB of internal RAM free with
# a largest block of ~14 KB, under the size of a full TLS record (measured
# 2026-10-06); with 1.4 it had been ~129 KB.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# ESP32-C6 link. esp_hosted 2.x knows the Tab5 (SDIO CMD 13, CLK 12,
# D0-D3 11/10/9/8, C6 reset on GPIO 15 active low, which matches M5Stack's
# pin table). In 2.x the SDIO pin options are derived from this board choice,
# so setting them directly, as 1.4 needed, is silently ignored.
CONFIG_ESP32P4_TAB5_C6_BOARD=y
# GPIO 15 must end high for the C6 to run, i.e. it behaves as an enable
# line. esp_hosted's Tab5 option defaults to active low, which 2.x honours by
# leaving the pin low and the C6 held in reset (SDIO init times out). 1.4.x
# only worked with "active low" because a bug made it ignore the setting
# (#ifdef on a macro that is always defined) and always drive the pin high.
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
# esp_hosted 2.x starts itself from a constructor, before the main task,
# while only about 150 KB of internal RAM is in the heap (the 256 KB region at
# 0x4FF40000 joins later). The default 20-deep queues took 125 KB of it:
# v0.2.0, with 10 KB more static data than v0.1.1, then had no room for the
# timer task's stack and boot-looped. 12 deep, as on the 3.4C and in
# traffic-display on this Tab5, takes 99 KB (measured there, 7 October 2026).
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=12
CONFIG_ESP_HOSTED_SDIO_RX_Q_SIZE=12
# Not ESP_HOSTED_MEMPOOL_PREFER_SPIRAM: with the transport buffers in PSRAM
# the first small transmit after joining failed ("sdio_write_task: Failed to
# send data: 258", ESP_ERR_INVALID_ARG), then "Unrecoverable host sdio state"
# and a restart, every boot (11 October 2026). Its 64-byte alignment is short
# of the 128-byte cache line DMA from PSRAM needs. traffic-display runs it,
# but mostly receives.
# Code and rodata run from PSRAM, so IDF keeps the cache on through flash
# writes and erases (SPI_FLASH_CACHE_NO_DISABLE). Without it both cores lose
# PSRAM, frame buffer included, for every write, and the panel flashed through
# an update and at every settings save. About 10 KB more static internal RAM
# and 2 MB of PSRAM.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Three frame buffers for esp_lvgl_adapter's TRIPLE_PARTIAL mode (see
# boards/tab5/board/board.c): it draws into one, rotating with the PPA when
# landscape, while another is on the panel. 5.5 MB of PSRAM.
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3

# Extra font sizes for the larger, finer-pitched panel
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y

# Certificates are checked in software. IDF 6's PSA driver otherwise uses the
# ECDSA peripheral, which this rev v1.x P4 lacks ("ECDSA peripheral not
# supported on this chip revision"), and every ECDSA-signed chain failed to
# verify: adsb.fi, Let's Encrypt's E intermediates (12 October 2026).
CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY=n
