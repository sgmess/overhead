menu "Overhead radar"

    comment "Everything else is set on the device's configuration page"

    config OVERHEAD_OTA_REPO
        string "GitHub repository for firmware updates (owner/name)"
        default "sgmess/overhead"
        help
            The configuration page checks this repository's latest release
            for <project>-ota.bin, e.g. overhead-tab5-ota.bin. Change it in
            a fork that publishes its own releases.

endmenu
